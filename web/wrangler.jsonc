{
	"name": "freedomtimes",
	"account_id": "bae3f835f19899c6eee1ec48f2d658cf",
	"main": "dist/server/entry.mjs",
	"compatibility_date": "2026-03-29",
	"logpush": true,
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"assets": {
		"directory": "dist/client",
		// Required: the @astrojs/cloudflare entry calls env.ASSETS.fetch() for routes no page matches
		// (fallbackToAssets) and for prerendered error pages. The adapter adds this binding to its generated
		// dist/server/wrangler.json, but deploys use this file (--config web/wrangler.jsonc), so it must be
		// named here. Without it every unmatched URL (e.g. /2026/10/11/) was a 500 "Cannot read properties
		// of undefined (reading 'fetch')". Checked by scripts/verify-worker-placement.mjs after each deploy.
		"binding": "ASSETS"
	},
	"vars": {
		// Vars shared by all environments (override in env block if needed)
		"SITE_ACCESS_MODE": "locked",
		"AUTH0_API_AUDIENCE": "https://api.freedomtimes.news",
		"API_BASE_URL": "https://local.freedomtimes.news/editorial",
		"COOKIE_BASE_DOMAIN": "freedomtimes.news",
		"AUTH0_ROLES_CLAIM_NAMESPACE": "https://freedomtimes.news/roles",
		"API_UPSTREAM_MODE": "apim",
		"CLOUDFLARE_ACCOUNT_ID": "bae3f835f19899c6eee1ec48f2d658cf",
		// Local-only dataset; staging/production dataset ids come from terraform output page_views_dataset
		"PAGE_VIEWS_DATASET": "freedomtimes_page_views_local"
	},
	// Aggregate page views of public reader HTML — see web/docs/ADMIN_ANALYTICS.md
	// Staging/production dataset names must match terraform output `page_views_dataset`
	"analytics_engine_datasets": [
		{
			"binding": "PAGE_VIEWS",
			"dataset": "freedomtimes_page_views_local"
		}
	],
	// Default (production) config
	"env": {
		"production": {
			"name": "freedomtimes",
			// Run the Worker next to the Turso primary (aws-eu-west-1, Dublin). Each page makes
			// several sequential libsql HTTP round trips; placement turns ~90 ms/trip from the US
			// into ~1-3 ms. Placement is NOT inherited from the top level — keep it per env.
			// Verify after deploy: `node scripts/verify-worker-placement.mjs --env <env>` (Cloudflare API:
			// placement mode "targeted" + region). The `cf-placement` response header is no longer emitted.
			"placement": {
				"region": "aws:eu-west-1"
			},
			// EmDash cloudflareEmail() — keep in sync with Terraform send_email binding EMAIL
			// (modules/cloudflare_holding_page). Deploy must not strip TF-owned bindings.
			"send_email": [
				{
					"name": "EMAIL",
					"allowed_sender_addresses": ["noreply@freedomtimes.news"]
				}
			],
			"kv_namespaces": [
				{
					"binding": "SESSION",
					"id": "962280ddb8f649b1a9482739fb295bdd"
				},
				{
					"binding": "READER_TEST_PUSH_THROTTLE",
					"id": "8414910d865d4c65b3ea181943c96aa9"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "freedomtimes-media-production"
				}
			],
			// Temporary D1 content backend (23 Nov 2026 Turso sync-quota outage). Binding name EMDASH
			// must match d1({ binding: "EMDASH" }) in astro.config.ts when FT_CONTENT_BACKEND=d1.
			// Swap back to Turso: set FT_CONTENT_BACKEND=turso, rebuild + deploy (or wrangler rollback
			// to 6926c482-02f8-4cdb-a379-e8de04f5c6c1). Terraform keeps it (modules/cloudflare_holding_page
			// keep_bindings includes d1) and can adopt the DB itself (environments/<env>/d1.tf).
			"d1_databases": [
				{
					"binding": "EMDASH",
					"database_name": "freedomtimes-emdash-production-fallback-20261123",
					"database_id": "ece69b46-eacd-4ce5-9923-68185cfcfb48"
				}
			],
			"analytics_engine_datasets": [
				{
					"binding": "PAGE_VIEWS",
					// Must match: terraform -chdir=infra/terraform/environments/production output -raw page_views_dataset
					"dataset": "freedomtimes_page_views"
				}
			],
			"vars": {
				// Single source of truth for the content backend (web/scripts/resolve-content-backend.mjs exports it for the build; d1 also bypasses Turso deploy steps with a WARNING). Default turso.
				"FT_CONTENT_BACKEND": "d1",
				"SITE_ACCESS_MODE": "public",
				// Reader notifications feature switch (web/docs/FEATURE_SWITCHES.md): off while the Turso subscriptions DB is blocked; set "on" after 1 Dec. Admins can override at /admin/feature-switches.
				"NOTIFICATIONS_ENABLED": "off",
				"API_BASE_URL": "https://api.freedomtimes.news/editorial",
				"AUTH0_API_AUDIENCE": "https://api.freedomtimes.news",
				"COOKIE_BASE_DOMAIN": "freedomtimes.news",
				"AUTH0_ROLES_CLAIM_NAMESPACE": "https://freedomtimes.news/roles",
				"API_UPSTREAM_MODE": "apim",
				"CLOUDFLARE_ACCOUNT_ID": "bae3f835f19899c6eee1ec48f2d658cf",
				// Must match terraform output page_views_dataset (TF pushes CLOUDFLARE_ANALYTICS_API_TOKEN as secret only)
				"PAGE_VIEWS_DATASET": "freedomtimes_page_views",
				// Anonymous reader HTML cache (src/lib/page-cache.ts). "on" enables it; anything else = off.
				"PAGE_CACHE": "on",
				"PAGE_CACHE_TTL_SECONDS": "120",
				// Publish does not post. The editor offers the links. An agent may offer to post after the 30-minute delay (X_AUTO_POST.md).
				"X_AUTO_POST_MODE": "dry-run"
			}
		},
		"staging": {
			"name": "freedomtimes-staging",
			// Run the Worker next to the Turso primary (aws-eu-west-1, Dublin). Each page makes
			// several sequential libsql HTTP round trips; placement turns ~90 ms/trip from the US
			// into ~1-3 ms. Placement is NOT inherited from the top level — keep it per env.
			// Verify after deploy: `node scripts/verify-worker-placement.mjs --env <env>` (Cloudflare API:
			// placement mode "targeted" + region). The `cf-placement` response header is no longer emitted.
			"placement": {
				"region": "aws:eu-west-1"
			},
			// EmDash cloudflareEmail() — keep in sync with Terraform send_email binding EMAIL.
			"send_email": [
				{
					"name": "EMAIL",
					"allowed_sender_addresses": ["noreply@freedomtimes.news"]
				}
			],
			"kv_namespaces": [
				{
					"binding": "SESSION",
					"id": "86dbef45deff49e4a12bff11b9148706"
				},
				{
					"binding": "READER_TEST_PUSH_THROTTLE",
					"id": "8ba24b04f64f4b4686830c7b86d6f147"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "freedomtimes-media-staging"
				}
			],
			// Temporary D1 content backend (23 Nov 2026 Turso sync-quota outage). Binding name EMDASH
			// must match d1({ binding: "EMDASH" }) in astro.config.ts when FT_CONTENT_BACKEND=d1.
			// Swap back to Turso: set FT_CONTENT_BACKEND=turso, rebuild + deploy (or wrangler rollback
			// to cb64d297-b665-4bce-8d30-bacd0d87b596). Terraform keeps it (modules/cloudflare_holding_page
			// keep_bindings includes d1) and can adopt the DB itself (environments/<env>/d1.tf).
			"d1_databases": [
				{
					"binding": "EMDASH",
					"database_name": "freedomtimes-emdash-staging-fallback-20261123",
					"database_id": "ba03720b-f6f8-4ab1-b3cf-c2809b4bb0bf"
				}
			],
			"analytics_engine_datasets": [
				{
					"binding": "PAGE_VIEWS",
					// Must match: terraform -chdir=infra/terraform/environments/staging output -raw page_views_dataset
					"dataset": "freedomtimes_staging_page_views"
				}
			],
			"vars": {
				// Single source of truth for the content backend (web/scripts/resolve-content-backend.mjs exports it for the build; d1 also bypasses Turso deploy steps with a WARNING). Default turso.
				"FT_CONTENT_BACKEND": "d1",
				"SITE_ACCESS_MODE": "locked",
				// Reader notifications feature switch (web/docs/FEATURE_SWITCHES.md): off while the Turso subscriptions DB is blocked; set "on" after 1 Dec. Admins can override at /admin/feature-switches.
				"NOTIFICATIONS_ENABLED": "off",
				// 5xx outage alert email (web/docs/OUTAGE_ALERTS.md). Production alerts by default; staging opts in.
				"OUTAGE_ALERTS": "on",
				"API_BASE_URL": "https://api-staging.freedomtimes.news/editorial",
				"AUTH0_API_AUDIENCE": "https://api.freedomtimes.news",
				"COOKIE_BASE_DOMAIN": "freedomtimes.news",
				"AUTH0_ROLES_CLAIM_NAMESPACE": "https://freedomtimes.news/roles",
				"API_UPSTREAM_MODE": "apim",
				"CLOUDFLARE_ACCOUNT_ID": "bae3f835f19899c6eee1ec48f2d658cf",
				// Must match terraform output page_views_dataset (TF pushes CLOUDFLARE_ANALYTICS_API_TOKEN as secret only)
				"PAGE_VIEWS_DATASET": "freedomtimes_staging_page_views",
				// Staging is locked (Auth0): every content response is per-session, so the anonymous
				// page cache must stay off here. Never set "on" for staging.
				"PAGE_CACHE": "off",
				// Staging never posts to X or Bluesky: mode is off (the handler skips entirely). ALLOW_SEND is production-only.
				"X_AUTO_POST_MODE": "off"
			}
		}
	}
}