{
	"name": "freedomtimes",
	"account_id": "bae3f835f19899c6eee1ec48f2d658cf",
	"main": "dist/server/entry.mjs",
	"compatibility_date": "2026-03-29",
	"logpush": true,
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"assets": {
		"directory": "dist/client"
	},
	"vars": {
		// Vars shared by all environments (override in env block if needed)
		"SITE_ACCESS_MODE": "locked",
		"AUTH0_API_AUDIENCE": "https://api.freedomtimes.news",
		"API_BASE_URL": "https://local.freedomtimes.news/editorial",
		"COOKIE_BASE_DOMAIN": "freedomtimes.news",
		"AUTH0_ROLES_CLAIM_NAMESPACE": "https://freedomtimes.news/roles",
		"API_UPSTREAM_MODE": "apim",
		"CLOUDFLARE_ACCOUNT_ID": "bae3f835f19899c6eee1ec48f2d658cf",
		// Local-only dataset; staging/production dataset ids come from terraform output page_views_dataset
		"PAGE_VIEWS_DATASET": "freedomtimes_page_views_local"
	},
	// Aggregate page views of public reader HTML — see web/docs/ADMIN_ANALYTICS.md
	// Staging/production dataset names must match terraform output `page_views_dataset`
	"analytics_engine_datasets": [
		{
			"binding": "PAGE_VIEWS",
			"dataset": "freedomtimes_page_views_local"
		}
	],
	// Default (production) config
	"env": {
		"production": {
			"name": "freedomtimes",
			// Run the Worker next to the Turso primary (aws-eu-west-1, Dublin). Each page makes
			// several sequential libsql HTTP round trips; placement turns ~90 ms/trip from the US
			// into ~1-3 ms. Placement is NOT inherited from the top level — keep it per env.
			// Verify after deploy: response header `cf-placement: remote-XXX` (or local-XXX near Dublin).
			"placement": {
				"region": "aws:eu-west-1"
			},
			// EmDash cloudflareEmail() — keep in sync with Terraform send_email binding EMAIL
			// (modules/cloudflare_holding_page). Deploy must not strip TF-owned bindings.
			"send_email": [
				{
					"name": "EMAIL",
					"allowed_sender_addresses": ["noreply@freedomtimes.news"]
				}
			],
			"kv_namespaces": [
				{
					"binding": "SESSION",
					"id": "962280ddb8f649b1a9482739fb295bdd"
				},
				{
					"binding": "READER_TEST_PUSH_THROTTLE",
					"id": "8414910d865d4c65b3ea181943c96aa9"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "freedomtimes-media-production"
				}
			],
			"analytics_engine_datasets": [
				{
					"binding": "PAGE_VIEWS",
					// Must match: terraform -chdir=infra/terraform/environments/production output -raw page_views_dataset
					"dataset": "freedomtimes_page_views"
				}
			],
			"vars": {
				"SITE_ACCESS_MODE": "public",
				"API_BASE_URL": "https://api.freedomtimes.news/editorial",
				"AUTH0_API_AUDIENCE": "https://api.freedomtimes.news",
				"COOKIE_BASE_DOMAIN": "freedomtimes.news",
				"AUTH0_ROLES_CLAIM_NAMESPACE": "https://freedomtimes.news/roles",
				"API_UPSTREAM_MODE": "apim",
				"CLOUDFLARE_ACCOUNT_ID": "bae3f835f19899c6eee1ec48f2d658cf",
				// Must match terraform output page_views_dataset (TF pushes CLOUDFLARE_ANALYTICS_API_TOKEN as secret only)
				"PAGE_VIEWS_DATASET": "freedomtimes_page_views",
				// Anonymous reader HTML cache (src/lib/page-cache.ts). "on" enables it; anything else = off.
				"PAGE_CACHE": "on",
				"PAGE_CACHE_TTL_SECONDS": "120"
			}
		},
		"staging": {
			"name": "freedomtimes-staging",
			// Run the Worker next to the Turso primary (aws-eu-west-1, Dublin). Each page makes
			// several sequential libsql HTTP round trips; placement turns ~90 ms/trip from the US
			// into ~1-3 ms. Placement is NOT inherited from the top level — keep it per env.
			// Verify after deploy: response header `cf-placement: remote-XXX` (or local-XXX near Dublin).
			"placement": {
				"region": "aws:eu-west-1"
			},
			// EmDash cloudflareEmail() — keep in sync with Terraform send_email binding EMAIL.
			"send_email": [
				{
					"name": "EMAIL",
					"allowed_sender_addresses": ["noreply@freedomtimes.news"]
				}
			],
			"kv_namespaces": [
				{
					"binding": "SESSION",
					"id": "86dbef45deff49e4a12bff11b9148706"
				},
				{
					"binding": "READER_TEST_PUSH_THROTTLE",
					"id": "8ba24b04f64f4b4686830c7b86d6f147"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "freedomtimes-media-staging"
				}
			],
			"analytics_engine_datasets": [
				{
					"binding": "PAGE_VIEWS",
					// Must match: terraform -chdir=infra/terraform/environments/staging output -raw page_views_dataset
					"dataset": "freedomtimes_staging_page_views"
				}
			],
			"vars": {
				"SITE_ACCESS_MODE": "locked",
				"API_BASE_URL": "https://api-staging.freedomtimes.news/editorial",
				"AUTH0_API_AUDIENCE": "https://api.freedomtimes.news",
				"COOKIE_BASE_DOMAIN": "freedomtimes.news",
				"AUTH0_ROLES_CLAIM_NAMESPACE": "https://freedomtimes.news/roles",
				"API_UPSTREAM_MODE": "apim",
				"CLOUDFLARE_ACCOUNT_ID": "bae3f835f19899c6eee1ec48f2d658cf",
				// Must match terraform output page_views_dataset (TF pushes CLOUDFLARE_ANALYTICS_API_TOKEN as secret only)
				"PAGE_VIEWS_DATASET": "freedomtimes_staging_page_views",
				// Staging is locked (Auth0): every content response is per-session, so the anonymous
				// page cache must stay off here. Never set "on" for staging.
				"PAGE_CACHE": "off"
			}
		}
	}
}