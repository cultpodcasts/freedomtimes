---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import PushNotificationsCallout from "../components/PushNotificationsCallout.astro";
import ReaderDataProvenance from "../components/ReaderDataProvenance.astro";
import Audio from "../components/Audio.astro";
import EmbedWithCaptions from "./EmbedWithCaptions.astro";
import VideoWithCaptions from "./VideoWithCaptions.astro";
import ImageWithLink from "./ImageWithLink.astro";
import EntryHeader from "./content/EntryHeader.astro";
import EntryMedia from "./content/EntryMedia.astro";
import EntryBody from "./content/EntryBody.astro";
import { getHomePath } from "../lib/auth";
import {
	buildPortableRenderNodes,
	parseLegacyTextContent,
} from "../lib/content/contentBlocks";
import {
	buildContentEntryViewModel,
	readEntrySeoRecord,
	resolveSocialImageSrc,
} from "../lib/content/contentEntry";
import { SITE_DISPLAY_NAME } from "../lib/site-brand";
import { getWeeklySummaries } from "../lib/seo/weekly-list";
import {
	WEEKLY_SUMMARIES_SECTION_TITLE,
	buildBreadcrumbJsonLd,
	buildNewsArticleJsonLd,
	contentCanonicalPath,
	findWeeklyNeighbours,
	isWeeklySummarySlug,
	readArticleStructuredFields,
	resolveArticleMeta,
	type WeeklyListItem,
} from "../lib/seo/article-seo";

const {
	entry,
	collectionLabel,
	emdashCollection,
	displayName,
	isPreview = false,
	isAdmin = false,
	isSignedIn,
	isEditor = false,
	pdfStatus = "unknown",
} = Astro.props as {
	entry: { id: string; slug?: string; data: Record<string, unknown> };
	collectionLabel: string;
	/** EmDash collection slug (`posts`, `pages`, `archives`, …) for `_emdash_seo` OG lookup */
	emdashCollection: string;
	displayName: string;
	isPreview?: boolean;
	isAdmin?: boolean;
	isSignedIn?: boolean;
	/** Auth0 `admin` or `editor` (#149 app environment link). */
	isEditor?: boolean;
	/** Archives only (#151): `missing` replaces the PDF link with an unavailable notice. */
	pdfStatus?: "available" | "missing" | "unknown";
};

const resolvedIsSignedIn = isSignedIn ?? false;
const {
	title,
	summaryParagraphs,
	portableContent,
	textContent,
	featuredImageSrc,
	featuredImageAlt,
	featuredImageCaption,
	volumeNumber,
	regionalVariant,
	pageImages,
	slidePageNumbers,
	slidePageTotal,
	pdfLink,
	subjectChips,
	subjects,
	issueDate,
	publishedAt,
	updatedAt,
	primaryByline,
	primaryBylineUrl,
} = buildContentEntryViewModel(
	entry as { slug?: string; data: Record<string, unknown> } & Record<
		string,
		unknown
	>,
);
const entryRecord = entry as Record<string, unknown>;
const seoRecord = readEntrySeoRecord(entryRecord);
const socialImageSrc = await resolveSocialImageSrc(entry.data, seoRecord, {
	origin: Astro.url.origin,
	emdashSeoLookup: {
		collection: emdashCollection,
		contentId: String(entry.id ?? ""),
		slug: typeof entry.slug === "string" ? entry.slug : undefined,
	},
});
// EmDash PortableText merges: defaults < plugin-embeds < user overrides.
// - image: FT ImageWithLink (figcaption + open full media in new tab)
// - link: EmDash defaults
// - youtube: plugin-embeds
// - video: one self-hosted player (1.2.0 block and older embed+provider video) plus core Video for other providers
// - embed: provider video uses that same player; other embeds use core Embed
// - audio: FT override (Apple/Spotify iframe podcasts — no official type yet)
const portableComponents = {
	type: {
		audio: Audio,
		embed: EmbedWithCaptions,
		image: ImageWithLink,
		video: VideoWithCaptions,
	},
};

const legacyBlocks = textContent ? parseLegacyTextContent(textContent) : [];
const portableRenderNodes = buildPortableRenderNodes(portableContent);
// Pages canonicalise to `/<slug>` (where they are served), not `/posts/<slug>`, which 301s (#34).
const canonicalPath = contentCanonicalPath(emdashCollection, entry.slug ?? entry.id);
const structuredFields = readArticleStructuredFields(entry.data);
// SEO record (title / description / canonical / noIndex) with fallbacks to the
// pre-existing behaviour. og:title never carries a date suffix.
const meta = resolveArticleMeta({
	title,
	seo: seoRecord,
	summaryParagraphs,
	canonicalPath,
	siteOrigin: Astro.url.origin,
	fields: structuredFields,
	fallbackDescription: `Read "${title}" on ${SITE_DISPLAY_NAME}.`,
});
const absoluteCanonicalUrl = new URL(meta.canonical, Astro.url).toString();
const entrySlug = typeof entry.slug === "string" ? entry.slug : String(entry.id ?? "");
const showReaderDataProvenance = entrySlug === "privacy-policy";
const isPost = emdashCollection === "posts";
const isWeekly = isPost && isWeeklySummarySlug(entrySlug);

let weeklyPrevious: WeeklyListItem | null = null;
let weeklyNext: WeeklyListItem | null = null;
if (isWeekly) {
	try {
		const items: WeeklyListItem[] = (await getWeeklySummaries()).map(({ slug, title, sortDate }) => ({ slug, title, sortDate }));
		if (!items.some((item) => item.slug === entrySlug)) {
			items.push({
				slug: entrySlug,
				title,
				sortDate: structuredFields.coverageStart ?? publishedAt ?? "",
			});
		}
		({ previous: weeklyPrevious, next: weeklyNext } = findWeeklyNeighbours(items, entrySlug));
	} catch (err) {
		// Prev/next is navigation sugar; never fail the article render for it.
		console.error("[EmDashContentView] weekly neighbours lookup failed", err);
	}
}

const jsonLd: Record<string, unknown>[] = isPost
	? [
			buildNewsArticleJsonLd({
				origin: Astro.url.origin,
				canonicalUrl: absoluteCanonicalUrl,
				headline: title,
				description: meta.description,
				fields: structuredFields,
				publishedAt,
				updatedAt,
				bylineName: primaryByline,
				bylineUrl: primaryBylineUrl,
				imageUrls: [socialImageSrc, featuredImageSrc].filter(
					(value): value is string => typeof value === "string" && value.length > 0,
				),
				subjects,
				siteName: SITE_DISPLAY_NAME,
				section: isWeekly
					? { name: WEEKLY_SUMMARIES_SECTION_TITLE }
					: null,
			}),
			buildBreadcrumbJsonLd({
				origin: Astro.url.origin,
				siteName: SITE_DISPLAY_NAME,
				trail: [
					{ name: title, url: absoluteCanonicalUrl },
				],
			}),
		]
	: [];
---

<Layout
	title={meta.title}
	socialTitle={meta.socialTitle}
	description={meta.description}
	canonicalUrl={meta.canonical}
	noindex={meta.noindex}
	jsonLd={jsonLd}
	ogType="article"
	ogImage={socialImageSrc ?? null}
	ogImageWidth={1200}
	ogImageHeight={675}
	ogImageAlt={socialImageSrc ? meta.socialTitle : undefined}
	publishedTime={publishedAt}
	modifiedTime={updatedAt}
	author={primaryByline}
>
	<article class="page-wrap">
		<Header
			section={collectionLabel}
			sectionUrl={collectionLabel === "Archive"
				? "/archives"
				: getHomePath()}
			isAdmin={isAdmin}
			isSignedIn={resolvedIsSignedIn}
			isEditor={isEditor}
		/>

		<div class="entry-shell">
			<EntryHeader
				title={title}
				issueDate={issueDate}
				primaryByline={primaryByline}
				publishedAt={publishedAt}
				updatedAt={updatedAt}
				isPreview={isPreview}
				subjectChips={subjectChips}
			/>

			<section class="content-card">
				<EntryMedia
					title={title}
					pageImages={pageImages}
					slidePageNumbers={slidePageNumbers}
					slidePageTotal={slidePageTotal}
					volumeNumber={volumeNumber}
					regionalVariant={regionalVariant}
					pdfLink={pdfLink}
					pdfStatus={pdfStatus}
					featuredImageSrc={featuredImageSrc}
					featuredImageAlt={featuredImageAlt}
					featuredImageCaption={featuredImageCaption}
				/>
				<EntryBody
					portableRenderNodes={portableRenderNodes}
					portableContent={portableContent}
					textContent={textContent}
					legacyBlocks={legacyBlocks}
					portableComponents={portableComponents}
				/>
				{(weeklyPrevious || weeklyNext) && (
					<nav class="weekly-nav" aria-label="Weekly summaries">
						{weeklyPrevious ? (
							<a class="weekly-nav-prev" rel="prev" href={`/posts/${weeklyPrevious.slug}`}>
								<span class="weekly-nav-label">← Previous week</span>
								<span class="weekly-nav-title">{weeklyPrevious.title}</span>
							</a>
						) : <span />}
						{weeklyNext ? (
							<a class="weekly-nav-next" rel="next" href={`/posts/${weeklyNext.slug}`}>
								<span class="weekly-nav-label">Next week →</span>
								<span class="weekly-nav-title">{weeklyNext.title}</span>
							</a>
						) : <span />}
					</nav>
				)}
				{showReaderDataProvenance && <ReaderDataProvenance />}
				<PushNotificationsCallout />
			</section>
		</div>
	</article>
	{/*
		Inside the Layout slot, not after </Layout>: a script placed after </Layout> is emitted after
		the document's </html> (follow-up to #124: those pages were never stored in the page cache).
		Module script, so it is deferred: it still runs after parsing, but now BEFORE Layout's
		native-bridge/PWA module script (module scripts run in document order). That is fine: the two
		are independent (.content-card here versus #push-notifications-callout and the bridges there).
	*/}
	<script>
		import { initContentEnhancements } from "../lib/content/contentEnhancements";

		initContentEnhancements();
	</script>
</Layout>

<style>
	.weekly-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		align-items: start;
		margin: 2.5rem 0 1.5rem;
		padding: 1.25rem 0;
		border-top: 1px solid #111111;
		border-bottom: 1px solid #eeeeee;
		font-family: "Inter", sans-serif;
	}

	.weekly-nav a {
		color: #111111;
		text-decoration: none;
	}

	.weekly-nav a:hover {
		color: #0044bb;
	}

	.weekly-nav-next {
		text-align: right;
	}


	.weekly-nav-label {
		display: block;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: #555555;
	}

	.weekly-nav-title {
		display: block;
		margin-top: 0.25rem;
		font-family: "Source Serif 4", serif;
		font-size: 1rem;
		line-height: 1.35;
	}

	@media (max-width: 640px) {
		.weekly-nav {
			grid-template-columns: 1fr;
		}

		.weekly-nav-next {
			text-align: left;
		}
	}

	.page-wrap {
		max-width: var(--max-width-article);
		margin: 0 auto;
		padding: 0 0 5rem;
	}

	:global(.legacy-details) {
		margin: 1.25rem 0;
		padding: 0.85rem 1rem;
		border: 1px solid #d8d8d8;
		border-radius: 8px;
		background: #f7f7f7;
	}

	:global(.legacy-details summary) {
		cursor: pointer;
		font-family: "Inter", sans-serif;
		font-weight: 600;
	}

	:global(.legacy-details p) {
		margin: 0.9rem 0 0;
	}

	/* Translation fold-out: not a blockquote (no left bar); keep distinct from body copy. */
	:global(.legacy-details.translate),
	:global(.legacy-details.translation) {
		border-left: none;
	}

	:global(.article-header h1) {
		margin: 0;
		font-family: "Playfair Display", serif;
		font-size: clamp(2.5rem, 7vw, 4.5rem);
		font-weight: 900;
		line-height: 1;
		letter-spacing: -0.01em;
	}

	:global(.issue-date) {
		margin: 1rem 0 0;
		font-family: "Inter", sans-serif;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		color: #333333;
	}

	:global(.article-header) {
		margin-bottom: 2.5rem;
		border-bottom: 1px solid #eeeeee;
		padding-bottom: 2rem;
	}

	:global(.article-meta) {
		display: flex;
		gap: 1.5rem;
		margin-top: 1rem;
		font-family: "Inter", sans-serif;
		font-size: 0.75rem;
		color: #777777;
		letter-spacing: 0.05em;
	}

	:global(.article-meta p) {
		margin: 0;
	}

	:global(.subject-list) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
	}

	:global(.subject-list li) {
		font-family: "Inter", sans-serif;
		font-size: 0.7rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		font-weight: 700;
		padding: 0.3rem 0.5rem;
		border: 1px solid var(--subject-chip-border, #dddddd);
		background: var(--subject-chip-bg, #fafafa);
		color: var(--subject-chip-text, #333333);
	}

	:global(.preview) {
		color: #cc0000;
		font-weight: 700;
	}

	.content-card {
		line-height: 1.7;
		font-size: 1.15rem;
	}

	.entry-shell {
		padding: 0 var(--page-padding-side);
	}

	:global(.hero) {
		margin: 0 0 3rem;
	}

	:global(.hero img) {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid #eeeeee;
	}

	:global(.fig-caption) {
		margin: 0.75rem 0 0;
		font-family: "Inter", sans-serif;
		font-size: 0.85rem;
		line-height: 1.45;
		color: #555555;
	}

	:global(.inline-figure),
	.content-card :global(.emdash-image) {
		margin: 0 0 2rem;
		max-width: 65ch;
	}

	:global(.inline-figure img),
	.content-card :global(.emdash-image img) {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid #eeeeee;
	}

	.content-card :global(.emdash-image-link) {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.content-card :global(.emdash-image figcaption) {
		margin: 0.75rem 0 0;
		font-family: "Inter", sans-serif;
		font-size: 0.85rem;
		line-height: 1.45;
		color: #555555;
		text-align: left;
	}

	:global(.slideshow) {
		margin: 0 0 4rem;
		padding: 2rem;
		background: #fcfcfc;
		border: 1px solid #eeeeee;
	}

	:global(.slideshow-header) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
		font-family: "Inter", sans-serif;
		letter-spacing: 0.1em;
	}

	:global(.slideshow-kicker) {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 700;
		color: #0044bb;
	}

	:global(.edition-meta) {
		margin: 0;
		font-size: 0.75rem;
		color: #777777;
	}

	:global(.slideshow-frame-wrap) {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: 1.5rem;
		align-items: center;
	}

	:global(.slideshow-frame) {
		position: relative;
		min-height: 400px;
		background: #ffffff;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
		border: 1px solid #eeeeee;
	}

	:global(.slide) {
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity 0.3s ease;
		margin: 0;
	}

	:global(.slide.is-active) {
		opacity: 1;
		position: relative;
	}

	:global(.slide img) {
		display: block;
		width: 100%;
		height: auto;
	}

	:global(.slide-nav) {
		background: #ffffff;
		border: 1px solid #dddddd;
		color: #111111;
		padding: 0.75rem 1rem;
		font-family: "Inter", sans-serif;
		font-weight: 700;
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	:global(.slide-nav:hover) {
		background: #111111;
		color: #ffffff;
		border-color: #111111;
	}

	:global(.slide-status) {
		margin: 1.5rem 0 0;
		text-align: center;
		font-family: "Inter", sans-serif;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	:global(.pdf-link-wrap) {
		margin: 1.5rem 0 0;
		text-align: center;
	}

	:global(.pdf-link-wrap a) {
		font-family: "Inter", sans-serif;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		color: #0044bb;
		text-decoration: none;
	}

	:global(.pdf-link-wrap a:hover) {
		text-decoration: underline;
	}

	/* One column measure for PT + legacy body: headings, embeds, and paragraphs share the same edge. */
	.content-card :global(.portable-content),
	.content-card :global(.legacy-content) {
		max-width: 65ch;
	}

	.content-card :global(p) {
		margin: 0 0 1.5rem;
		max-width: 65ch;
	}

	.content-card :global(h2),
	.content-card :global(h3),
	.content-card :global(h4) {
		font-family: "Playfair Display", serif;
		font-weight: 800;
		line-height: 1.2;
		margin: 3rem 0 1rem;
	}

	.content-card :global(a) {
		color: #0044bb;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.content-card :global(blockquote) {
		margin: 2rem 0;
		padding: 1rem 1.25rem;
		max-width: 65ch;
		border-left: 4px solid #111111;
		background: #f8f8f8;
	}

	.content-card :global(blockquote p) {
		margin: 0;
		font-family: "Source Serif 4", serif;
		font-style: italic;
		color: #1f1f1f;
	}

	.content-card :global(.emdash-embed) {
		margin: 2rem 0;
		max-width: 65ch;
	}

	/*
	 * EmDash Embed.astro uses a classic 16:9 padding-bottom box for .emdash-embed-video
	 * (iframe + self-hosted <video>). Cinematic / wider-than-16:9 MP4s then leave a
	 * white gap under the player before figcaption. Collapse that box for native video
	 * and size from the file’s intrinsic ratio; keep 16:9 for iframes / lite-youtube.
	 */
	.content-card :global(.emdash-embed-video:has(> video)) {
		position: static;
		height: auto;
		padding-bottom: 0;
		overflow: visible;
	}

	.content-card :global(.emdash-embed-video video) {
		position: static;
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid #eeeeee;
		background: #000000;
	}

	/*
	 * Single VTT cue per turn: continuous "NAME: dialogue" (no forced \\n).
	 * Overlap stack uses VTT line:% (speaking order).
	 * Name vs speech is typographic (caps + colon) — no hair spaces.
	 * Colours: <c.jt|mccallum|gardiner|sidney|hall> + ::cue(.class).
	 * ::cue(v[voice="…"]) is ignored in Chromium/Firefox — do not rely on it.
	 */
	.content-card :global(.emdash-embed-video video::cue) {
		font-family: "Inter", system-ui, sans-serif;
		/* Smaller on ~375px so two cue stacks fit above controls */
		font-size: clamp(0.72rem, 2.6vw, 1.05rem);
		font-weight: 700;
		line-height: 1.2;
		color: #E8E8E8;
		background-color: rgba(0, 0, 0, 0.72);
		white-space: normal;
	}

	.content-card :global(.emdash-embed-video video::cue(.jt)) {
		color: #E8E8E8;
	}

	.content-card :global(.emdash-embed-video video::cue(.mccallum)) {
		color: #9EC9FF;
	}

	.content-card :global(.emdash-embed-video video::cue(.gardiner)) {
		color: #E8D48A;
	}

	.content-card :global(.emdash-embed-video video::cue(.sidney)) {
		color: #C9A0E8;
	}

	.content-card :global(.emdash-embed-video video::cue(.hall)) {
		color: #888888;
	}

	.content-card :global(.emdash-embed-video iframe),
	.content-card :global(lite-youtube) {
		display: block;
		width: 100%;
		aspect-ratio: var(--video-aspect-ratio, 16 / 9);
		border: 1px solid #eeeeee;
		background-color: #000000;
	}

	/*
	 * lite-youtube paints the YouTube poster as an inline background-image on
	 * the host. Do not use the `background` shorthand here — it resets
	 * background-size / repeat / position to initial (auto / repeat / 0 0),
	 * so hqdefault (480×360) tiles across the 16:9 player instead of covering
	 * it. Restore cover + no-repeat + center; keep background-color for any
	 * remaining letterbox. Play-button hit area is the full-size child
	 * `.lyt-playbtn` and is not affected by these host poster properties.
	 */
	.content-card :global(lite-youtube) {
		background-size: cover;
		background-repeat: no-repeat;
		background-position: center;
	}

	@media (max-width: 768px) {
		.page-wrap {
			padding: 0 0 2.25rem;
		}
		.masthead {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
		.meta-block {
			align-items: flex-start;
			text-align: left;
		}
		nav {
			justify-content: flex-start;
		}
		:global(.slideshow-frame-wrap) {
			grid-template-columns: 1fr;
		}
		:global(.slide-nav) {
			width: 100%;
		}
	}
</style>
