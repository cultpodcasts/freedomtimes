---
import { subjectChipStyle } from '../../lib/subjects/chip';
import { subjectPath } from '../../lib/subjects/slug';

interface Props {
	subjects: string[];
}

const { subjects } = Astro.props;
const chips = subjects.map((label) => ({
	label,
	href: subjectPath(label),
	style: subjectChipStyle(label),
}));
---

{chips.length > 0 && (
	<ul class="subject-list" aria-label="Subjects">
		{chips.map((chip) => (
			<li>
				{chip.href ? (
					<a href={chip.href} rel="tag" style={chip.style}>{chip.label}</a>
				) : (
					<span style={chip.style}>{chip.label}</span>
				)}
			</li>
		))}
	</ul>
)}

<style>
	.subject-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0.75rem 0 0;
	}

	.subject-list a,
	.subject-list span {
		display: inline-block;
		font-family: 'Inter', sans-serif;
		font-size: 0.7rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		font-weight: 700;
		padding: 0.3rem 0.5rem;
		border: 1px solid var(--subject-chip-border, #dddddd);
		background: var(--subject-chip-bg, #fafafa);
		color: var(--subject-chip-text, #333333);
		text-decoration: none;
	}

	.subject-list a:hover {
		text-decoration: underline;
	}

	.subject-list a:focus-visible {
		outline: 2px solid #0044bb;
		outline-offset: 2px;
	}
</style>
