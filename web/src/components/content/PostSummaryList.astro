---
import SubjectList from './SubjectList.astro';

export type PostSummary = {
	slug: string;
	title: string;
	excerpt: string | null;
	subjects: string[];
	publishedAt: string | null;
};

interface Props {
	posts: PostSummary[];
}

const { posts } = Astro.props;

function formatShortDate(value: string | null): string | null {
	if (!value) return null;
	const parsed = new Date(value);
	if (Number.isNaN(parsed.getTime())) return value;
	return parsed.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}
---

<ul class="post-summaries">
	{posts.map((post) => {
		const date = formatShortDate(post.publishedAt);
		return (
			<li>
				<article class="post-summary">
					{date && <p class="date">{date}</p>}
					<h2><a href={`/posts/${post.slug}`}>{post.title}</a></h2>
					<SubjectList subjects={post.subjects} />
					{post.excerpt && <p class="dek">{post.excerpt}</p>}
				</article>
			</li>
		);
	})}
</ul>

<style>
	.post-summaries {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 2rem;
	}

	.post-summary {
		padding-bottom: 1.5rem;
		border-bottom: 1px solid #eeeeee;
	}

	.date {
		margin: 0 0 0.35rem;
		font-family: 'Inter', sans-serif;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: #0044bb;
	}

	h2 {
		margin: 0;
		font-family: 'Playfair Display', serif;
		font-weight: 900;
		font-size: clamp(1.4rem, 3vw, 2rem);
		line-height: 1.15;
		letter-spacing: -0.015em;
	}

	h2 a {
		color: #111111;
		text-decoration: none;
	}

	h2 a:hover {
		color: #0044bb;
	}

	h2 a:focus-visible {
		outline: 2px solid #0044bb;
		outline-offset: 2px;
	}

	.dek {
		margin: 0.75rem 0 0;
		font-family: 'Source Serif 4', serif;
		font-size: 1.05rem;
		line-height: 1.5;
		color: #333333;
	}
</style>
