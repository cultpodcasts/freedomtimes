---
/**
 * Portable Text `_type: "video"` override for EmDash 1.2.0.
 *
 * `resolveVideoBlockPlayback` chooses the player. A provider other than
 * `local` goes to core `Video` with built-in fields only, so `getEmbed` runs.
 * An allow-listed local file stays here, including caption tracks and no poster.
 * A refused URL or an empty block renders nothing.
 *
 * Core `Video` renders only `_type`, `_key`, `asset`, `caption`, `width`, and
 * `height`. A `poster` or WebVTT extra makes that check fail. Local `getEmbed`
 * also never sets `poster`, so this player reserves width and height when a
 * poster is shown.
 */
import { Video as CoreVideo } from 'emdash/ui';
import {
	resolveVideoBlockPlayback,
	resolveVideoCaptionTracks,
} from '../lib/content/videoCaptionTracks';
import {
	resolveSelfHostedVideoFrame,
	resolveVideoPoster,
	selfHostedVideoPreload,
} from '../lib/content/videoPoster';

const props = Astro.props as Record<string, unknown>;
const node =
	(props.node as Record<string, unknown> | undefined)
	?? (props.value as Record<string, unknown> | undefined)
	?? props;

function readString(input: unknown): string | null {
	return typeof input === 'string' && input.trim().length > 0 ? input.trim() : null;
}

const playback = node._type === 'video' ? resolveVideoBlockPlayback(node) : null;
const src = playback?.kind === 'local' ? playback.src : null;
const coreNode = playback?.kind === 'core' ? playback.node : null;
const caption = readString(node.caption);
const poster = src ? resolveVideoPoster(node) : null;
const frame = src ? resolveSelfHostedVideoFrame(node, poster) : null;
const preload = selfHostedVideoPreload(poster);
const captionTracks = src ? resolveVideoCaptionTracks(node, src) : [];
---

{
	src ? (
		<figure class="emdash-embed">
			<div class="emdash-embed-video">
				<video
					controls
					preload={preload}
					poster={poster?.src}
					width={frame?.width}
					height={frame?.height}
					style={frame ? { aspectRatio: frame.aspectRatio } : undefined}
				>
					<source src={src} type="video/mp4" />
					{captionTracks.map((track) =>
						track.isDefault ? (
							<track
								kind="captions"
								src={track.src}
								srclang={track.srclang}
								label={track.label}
								default
							/>
						) : (
							<track
								kind="captions"
								src={track.src}
								srclang={track.srclang}
								label={track.label}
							/>
						),
					)}
				</video>
			</div>
			{caption && <figcaption>{caption}</figcaption>}
		</figure>
	) : coreNode ? (
		<CoreVideo node={coreNode} />
	) : null
}
