---
/**
 * Portable Text `_type: "embed"` override.
 *
 * `provider: "video"` plays through `VideoWithCaptions`, the same player as an
 * EmDash 1.2.0 video block (poster, WebVTT, reserved box). Every other embed
 * falls through to core `Embed`.
 */
import { Embed as CoreEmbed } from 'emdash/ui';
import { resolveStoredVideoPlayback } from '../lib/content/videoPlayback';
import VideoWithCaptions from './VideoWithCaptions.astro';

const props = Astro.props as Record<string, unknown>;
const node =
	(props.node as Record<string, unknown> | undefined)
	?? (props.value as Record<string, unknown> | undefined)
	?? props;

function readString(input: unknown): string | null {
	return typeof input === 'string' && input.trim().length > 0 ? input.trim() : null;
}

const provider = readString(node.provider);
const caption = readString(node.caption);
const selfHosted =
	provider === 'video' && resolveStoredVideoPlayback(node).kind === 'player';
---

{
	selfHosted ? (
		<VideoWithCaptions node={node} />
	) : typeof node.url === 'string' ? (
		<CoreEmbed
			node={{
				_type: 'embed',
				_key: typeof node._key === 'string' ? node._key : 'embed',
				url: node.url,
				provider: typeof node.provider === 'string' ? node.provider : undefined,
				html: typeof node.html === 'string' ? node.html : undefined,
				caption: caption ?? undefined,
			}}
		/>
	) : null
}
