---
import { getEmDashEntry } from 'emdash';

import EmDashContentView from '../../components/EmDashContentView.astro';
import Layout from '../../layouts/Layout.astro';
import { getHomePath, readOptionalEnv } from '../../lib/auth';
import {
	getOptionalEditorialSession,
	requireEditorialSession,
} from '../../lib/editorial-session';
import {
	isExplicitPreviewRequest,
	shouldRenderPublicPost,
} from '../../lib/published-post-entry';
import { withDeadline } from '../../lib/with-deadline';

const siteAccessMode = readOptionalEnv('SITE_ACCESS_MODE').trim().toLowerCase();
const isLocked = siteAccessMode !== 'public';
const ssrStarted = performance.now();
const cfRay = Astro.request.headers.get('cf-ray') ?? '';
const allowPreview = isExplicitPreviewRequest(Astro.url);

function logPostSsr(event: string, extra: Record<string, string | number | boolean | null | undefined> = {}) {
	console.log('[ft-ssr]', JSON.stringify({
		event,
		cfRay,
		pathname: Astro.url.pathname,
		elapsedMs: Math.round(performance.now() - ssrStarted),
		...extra,
	}));
}

let displayName = 'Reader';
let isAdmin = false;
let isSignedIn = false;

const sessionContext = {
	cookies: Astro.cookies,
	url: Astro.url,
	request: Astro.request,
	redirect: Astro.redirect,
};

// Redirects already ran in middleware.outer (EmDash's own handler) before
// this page. Session + getEmDashEntry run only on a redirect miss.
logPostSsr('session-start', { locked: isLocked });
try {
	if (isLocked) {
		const session = await withDeadline(
			requireEditorialSession(sessionContext),
			5_000,
			'requireEditorialSession',
		);

		if (session instanceof Response) {
			logPostSsr('session-redirect', { status: session.status });
			return session;
		}

		displayName = session.displayName;
		isAdmin = session.isAdmin;
		isSignedIn = true;
	} else {
		const session = await withDeadline(
			getOptionalEditorialSession(sessionContext),
			5_000,
			'getOptionalEditorialSession',
		);
		if (session) {
			displayName = session.displayName;
			isAdmin = session.isAdmin;
			isSignedIn = true;
		}
	}
	logPostSsr('session-end', { isSignedIn, isAdmin });
} catch (error) {
	const message = error instanceof Error ? error.message : String(error);
	logPostSsr('session-timeout', { error: message });
	return new Response('Editorial session timed out', {
		status: 503,
		headers: { 'content-type': 'text/plain; charset=utf-8' },
	});
}

const slug = Astro.params.slug;
let entry: Awaited<ReturnType<typeof getEmDashEntry>>['entry'] = null;
let isPreview = false;
let notFound = false;

if (!slug) {
	notFound = true;
	Astro.response.status = 404;
} else {
	logPostSsr('entry-start', { slug, allowPreview });
	let result: Awaited<ReturnType<typeof getEmDashEntry>>;
	try {
		result = await withDeadline(getEmDashEntry('posts', slug), 8_000, 'getEmDashEntry');
	} catch (error) {
		const message = error instanceof Error ? error.message : String(error);
		logPostSsr('entry-timeout', { slug, error: message });
		return new Response('Post lookup timed out', {
			status: 503,
			headers: { 'content-type': 'text/plain; charset=utf-8' },
		});
	}
	entry = result.entry;
	isPreview = result.isPreview;
	logPostSsr('entry-end', { slug, hasEntry: Boolean(entry), isPreview });

	if (result.error) {
		logPostSsr('entry-error', {
			slug,
			error: result.error instanceof Error ? result.error.message : String(result.error),
		});
		entry = null;
	}

	// No collection scan. A 100-row fallback can hydrate
	// weekly-summary-30-august-2026-unpublished and wedge the isolate.
	if (!shouldRenderPublicPost({ slug, isPreview, entry, allowPreview })) {
		logPostSsr('entry-refused', {
			slug,
			isPreview,
			allowPreview,
			hasEntry: Boolean(entry),
		});
		entry = null;
		isPreview = false;
		notFound = true;
		Astro.response.status = 404;
	}
}
---

{notFound || !entry ? (
	<Layout>
		<article class="not-found-wrap">
			<header class="masthead">
				<p class="eyebrow">Post</p>
				<h1>Post not found</h1>
				<p class="summary">The requested post may have been unpublished, moved, or removed.</p>
			</header>
			<nav>
				<a href={getHomePath()}>Back to homepage</a>
				<a href="/_emdash/admin">Open CMS</a>
			</nav>
		</article>
	</Layout>
) : (
	<EmDashContentView
		entry={entry}
		collectionLabel="Post"
		emdashCollection="posts"
		displayName={displayName}
		isPreview={isPreview}
		isAdmin={isAdmin}
		isSignedIn={isSignedIn}
	/>
)}

<style>
	.not-found-wrap {
		max-width: 860px;
		margin: 0 auto;
		padding: 2rem 1.25rem 3rem;
	}

	.masthead {
		border-bottom: 1px solid #111111;
		padding-bottom: 1.5rem;
		margin-bottom: 2rem;
	}

	.eyebrow {
		margin: 0;
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0.2rem 0 0;
		font-size: clamp(2.2rem, 6vw, 4.25rem);
		line-height: 0.95;
		font-family: 'Playfair Display', serif;
	}

	.summary {
		margin: 0.8rem 0 0;
		font-size: 1.08rem;
		line-height: 1.6;
	}

	nav {
		display: flex;
		gap: 0.9rem;
		flex-wrap: wrap;
	}

	nav a {
		color: #111111;
		font-weight: 700;
		text-decoration: none;
	}

	nav a:hover {
		color: #0044bb;
		text-decoration: underline;
	}
</style>
