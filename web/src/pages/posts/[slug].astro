---
import { getEmDashEntry } from 'emdash';

import EmDashContentView from '../../components/EmDashContentView.astro';
import Layout from '../../layouts/Layout.astro';
import { getHomePath, readOptionalEnv } from '../../lib/auth';
import {
	getOptionalEditorialSession,
	requireEditorialSession,
} from '../../lib/editorial-session';

const siteAccessMode = readOptionalEnv('SITE_ACCESS_MODE').trim().toLowerCase();
const isLocked = siteAccessMode !== 'public';
const ssrStarted = performance.now();
const cfRay = Astro.request.headers.get('cf-ray') ?? '';

function logPostSsr(event: string, extra: Record<string, string | number | boolean | null | undefined> = {}) {
	console.log('[ft-ssr]', JSON.stringify({
		event,
		cfRay,
		pathname: Astro.url.pathname,
		elapsedMs: Math.round(performance.now() - ssrStarted),
		...extra,
	}));
}

let displayName = 'Reader';
let isAdmin = false;
let isSignedIn = false;

const sessionContext = {
	cookies: Astro.cookies,
	url: Astro.url,
	request: Astro.request,
	redirect: Astro.redirect,
};

// Editorial 302s are EmDash's (`emdash/middleware/redirect` after getRuntime).
// This page only runs on a miss. Do not second-guess getEmDashEntry / edit / preview.
logPostSsr('session-start', { locked: isLocked });
if (isLocked) {
	const session = await requireEditorialSession(sessionContext);

	if (session instanceof Response) {
		logPostSsr('session-redirect', { status: session.status });
		return session;
	}

	displayName = session.displayName;
	isAdmin = session.isAdmin;
	isSignedIn = true;
} else {
	const session = await getOptionalEditorialSession(sessionContext);
	if (session) {
		displayName = session.displayName;
		isAdmin = session.isAdmin;
		isSignedIn = true;
	}
}
logPostSsr('session-end', { isSignedIn, isAdmin });

const slug = Astro.params.slug;
let entry: Awaited<ReturnType<typeof getEmDashEntry>>['entry'] = null;
let isPreview = false;
let notFound = false;

if (!slug) {
	notFound = true;
	Astro.response.status = 404;
} else {
	logPostSsr('entry-start', { slug });
	const result = await getEmDashEntry('posts', slug);
	entry = result.entry;
	isPreview = result.isPreview;
	logPostSsr('entry-end', { slug, hasEntry: Boolean(entry), isPreview });

	if (result.error) {
		const message = result.error instanceof Error ? result.error.message : String(result.error);
		logPostSsr('entry-error', { slug, error: message });
		const lower = message.toLowerCase();
		const isExpectedLookupMiss =
			lower.includes('not found')
			|| lower.includes('no row')
			|| lower.includes('missing')
			|| lower.includes('no such table')
			|| lower.includes('does not exist')
			|| lower.includes('unknown collection');
		if (!isExpectedLookupMiss) {
			throw result.error;
		}
		entry = null;
	}

	if (!entry) {
		notFound = true;
		Astro.response.status = 404;
	}
}
---

{notFound || !entry ? (
	<Layout>
		<article class="not-found-wrap">
			<header class="masthead">
				<p class="eyebrow">Post</p>
				<h1>Post not found</h1>
				<p class="summary">The requested post may have been unpublished, moved, or removed.</p>
			</header>
			<nav>
				<a href={getHomePath()}>Back to homepage</a>
				<a href="/_emdash/admin">Open CMS</a>
			</nav>
		</article>
	</Layout>
) : (
	<EmDashContentView
		entry={entry}
		collectionLabel="Post"
		emdashCollection="posts"
		displayName={displayName}
		isPreview={isPreview}
		isAdmin={isAdmin}
		isSignedIn={isSignedIn}
	/>
)}

<style>
	.not-found-wrap {
		max-width: 860px;
		margin: 0 auto;
		padding: 2rem 1.25rem 3rem;
	}

	.masthead {
		border-bottom: 1px solid #111111;
		padding-bottom: 1.5rem;
		margin-bottom: 2rem;
	}

	.eyebrow {
		margin: 0;
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0.2rem 0 0;
		font-size: clamp(2.2rem, 6vw, 4.25rem);
		line-height: 0.95;
		font-family: 'Playfair Display', serif;
	}

	.summary {
		margin: 0.8rem 0 0;
		font-size: 1.08rem;
		line-height: 1.6;
	}

	nav {
		display: flex;
		gap: 0.9rem;
		flex-wrap: wrap;
	}

	nav a {
		color: #111111;
		font-weight: 700;
		text-decoration: none;
	}

	nav a:hover {
		color: #0044bb;
		text-decoration: underline;
	}
</style>
