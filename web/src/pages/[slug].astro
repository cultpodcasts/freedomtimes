---
import { getEmDashEntry } from 'emdash';

import EmDashContentView from '../components/EmDashContentView.astro';
import HomepageView from '../components/HomepageView.astro';
import { isLockedSiteAccess, readOptionalEnv, REFRESH_TOKEN_COOKIE, SESSION_COOKIE } from '../lib/auth';
import {
	HOMEPAGE_ROOT_REDIRECT_LOCATION,
	shouldRedirectHomepageToRoot,
} from '../lib/homepage-host';
import {
	getOptionalEditorialSession,
	requireEditorialSession,
} from '../lib/editorial-session';
import { resolveHomepageGet } from '../lib/root-route';

const slug = Astro.params.slug;
if (!slug) {
	return new Response('Missing slug', { status: 400 });
}

if (slug === 'homepage' && shouldRedirectHomepageToRoot({
	pathname: Astro.url.pathname,
	hostname: Astro.url.hostname,
	siteAccessMode: readOptionalEnv('SITE_ACCESS_MODE'),
})) {
	return Astro.redirect(HOMEPAGE_ROOT_REDIRECT_LOCATION, 301);
}

/** `/homepage` is a staging-only URL; production serves the newsroom at `/`. */
const isHomepage = slug === 'homepage' && isLockedSiteAccess();

const isLocked = isLockedSiteAccess();

let displayName = 'Reader';
let isAdmin = false;
let isSignedIn = false;
let resolvedEntry: Awaited<ReturnType<typeof getEmDashEntry>>['entry'] = null;
let resolvedIsPreview = false;
let resolvedLabel = 'Page';
let resolvedCollectionKey: 'pages' | 'posts' | null = null;
const sessionContext = {
	cookies: Astro.cookies,
	url: Astro.url,
	request: Astro.request,
	redirect: Astro.redirect,
};

if (isHomepage) {
	const homepageAction = resolveHomepageGet({
		siteAccess: isLocked ? 'locked' : 'public',
		hostname: Astro.url.hostname,
		sessionCookie: Astro.cookies.get(SESSION_COOKIE)?.value,
		refreshCookie: Astro.cookies.get(REFRESH_TOKEN_COOKIE)?.value,
	});

	if (homepageAction.kind === 'redirect') {
		return Astro.redirect(homepageAction.location, homepageAction.status);
	}

	if (homepageAction.kind === 'require-session') {
		const session = await requireEditorialSession(sessionContext);

		if (session instanceof Response) {
			return session;
		}

		isAdmin = session.isAdmin;
		isSignedIn = true;
	}
} else if (isLocked) {
	const session = await requireEditorialSession(sessionContext);

	if (session instanceof Response) {
		return session;
	}

	displayName = session.displayName;
	isAdmin = session.isAdmin;
	isSignedIn = true;
} else {
	const session = await getOptionalEditorialSession(sessionContext);
	if (session) {
		displayName = session.displayName;
		isAdmin = session.isAdmin;
		isSignedIn = true;
	}
}

if (!isHomepage) {

	const collections = [
		{ key: 'pages', label: 'Page' },
		{ key: 'posts', label: 'Post' },
	] as const;

	let lastUnexpectedError: string | null = null;

	for (const collection of collections) {
		const { entry, error, isPreview } = await getEmDashEntry(collection.key, slug);

		if (error) {
			const message = error instanceof Error ? error.message : String(error);
			const lower = message.toLowerCase();

			const isExpectedLookupMiss =
				lower.includes('not found')
				|| lower.includes('no row')
				|| lower.includes('missing')
				|| lower.includes('no such table')
				|| lower.includes('does not exist')
				|| lower.includes('unknown collection');

			if (!isExpectedLookupMiss) {
				lastUnexpectedError = message;
				console.error('[page.slug] failed to resolve entry', {
					slug,
					collection: collection.key,
					message,
				});
			}

			continue;
		}

		if (entry) {
			resolvedEntry = entry;
			resolvedIsPreview = isPreview;
			resolvedLabel = collection.label;
			resolvedCollectionKey = collection.key;
			break;
		}
	}

	if (!resolvedEntry) {
		if (lastUnexpectedError) {
			return new Response('Unable to load page right now', { status: 500 });
		}

		return new Response('Page not found', { status: 404 });
	}
}
---

{isHomepage ? (
	<HomepageView isAdmin={isAdmin} isSignedIn={isSignedIn} />
) : (
	<EmDashContentView
		entry={resolvedEntry!}
		collectionLabel={resolvedLabel}
		emdashCollection={resolvedCollectionKey ?? 'pages'}
		displayName={displayName}
		isPreview={resolvedIsPreview}
		isAdmin={isAdmin}
		isSignedIn={isSignedIn}
	/>
)}
