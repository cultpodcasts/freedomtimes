---
import { getEmDashEntry } from 'emdash';

import EmDashContentView from '../../components/EmDashContentView.astro';
import NotFoundView from '../../components/NotFoundView.astro';
import { readOptionalEnv } from '../../lib/auth';
import {
	getOptionalEditorialSession,
	requireEditorialSession,
} from '../../lib/editorial-session';
import { isExpectedLookupMiss } from '../../lib/not-found';

const siteAccessMode = readOptionalEnv('SITE_ACCESS_MODE').trim().toLowerCase();
const isLocked = siteAccessMode !== 'public';

let displayName = 'Reader';
let isAdmin = false;
let isSignedIn = false;

const sessionContext = {
	cookies: Astro.cookies,
	url: Astro.url,
	request: Astro.request,
	redirect: Astro.redirect,
};

if (isLocked) {
	const session = await requireEditorialSession(sessionContext);

	if (session instanceof Response) {
		return session;
	}

	displayName = session.displayName;
	isAdmin = session.isAdmin;
	isSignedIn = true;
} else {
	const session = await getOptionalEditorialSession(sessionContext);
	if (session) {
		displayName = session.displayName;
		isAdmin = session.isAdmin;
		isSignedIn = true;
	}
}

const slug = Astro.params.slug;
let entry: Awaited<ReturnType<typeof getEmDashEntry>>['entry'] = null;
let isPreview = false;
let notFound = false;

if (!slug) {
	notFound = true;
	Astro.response.status = 404;
} else {
	// EmDash's loader matches the param against the entry's slug OR its id, so both
	// `/archives/<slug>` and `/archives/<id>` resolve here with no fallback scan.
	const result = await getEmDashEntry('archives', slug);
	entry = result.entry;
	isPreview = result.isPreview;

	if (result.error) {
		// A miss is `entry: null` with no error; any error is a real failure (#121), so rethrow
		// and let src/pages/500.astro render.
		if (!isExpectedLookupMiss(result.error)) {
			throw result.error;
		}
		entry = null;
	}

	if (!entry) {
		notFound = true;
		Astro.response.status = 404;
	}
}
---

{notFound || !entry ? (
	<NotFoundView eyebrow="Archive" heading="Archive not found" summary="The requested archive issue may have been unpublished, moved, or removed." />
) : (
	<EmDashContentView
		entry={entry}
		collectionLabel="Archive"
		emdashCollection="archives"
		displayName={displayName}
		isPreview={isPreview}
		isAdmin={isAdmin}
		isSignedIn={isSignedIn}
	/>
)}

