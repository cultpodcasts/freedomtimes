---
import { env as cfEnv } from 'cloudflare:workers';
import { getEmDashEntry } from 'emdash';

import EmDashContentView from '../../components/EmDashContentView.astro';
import NotFoundView from '../../components/NotFoundView.astro';
import { readOptionalEnv } from '../../lib/auth';
import {
	getOptionalEditorialSession,
	requireEditorialSession,
} from '../../lib/editorial-session';
import { rethrowLookupFailure } from '../../lib/content-store-guard';
import { assertContentStoreReady } from '../../lib/content-store-guard-db';
import { isExpectedLookupMiss } from '../../lib/not-found';
import { archivePdfCacheControl, checkArchivePdf, type ArchivePdfStatus, type MediaHead } from '../../lib/content/archive-pdf';
import { ARCHIVE_GONE_CACHE_CONTROL, ARCHIVE_GONE_STATUS, checkArchiveWithdrawn } from '../../lib/content/archive-withdrawn';
import { lookupArchiveRowState } from '../../lib/content/archive-withdrawn-db';
import { buildContentEntryViewModel } from '../../lib/content/contentEntry';

const siteAccessMode = readOptionalEnv('SITE_ACCESS_MODE').trim().toLowerCase();
const isLocked = siteAccessMode !== 'public';

let displayName = 'Reader';
let isAdmin = false;
let isSignedIn = false;

const sessionContext = {
	cookies: Astro.cookies,
	url: Astro.url,
	request: Astro.request,
	redirect: Astro.redirect,
};

if (isLocked) {
	const session = await requireEditorialSession(sessionContext);

	if (session instanceof Response) {
		return session;
	}

	displayName = session.displayName;
	isAdmin = session.isAdmin;
	isSignedIn = true;
} else {
	const session = await getOptionalEditorialSession(sessionContext);
	if (session) {
		displayName = session.displayName;
		isAdmin = session.isAdmin;
		isSignedIn = true;
	}
}

const slug = Astro.params.slug;
let entry: Awaited<ReturnType<typeof getEmDashEntry>>['entry'] = null;
let isPreview = false;
let notFound = false;
let withdrawn = false;

if (!slug) {
	notFound = true;
	Astro.response.status = 404;
} else {
	// EmDash's loader matches the param against the entry's slug OR its id, so both
	// `/archives/<slug>` and `/archives/<id>` resolve here with no fallback scan.
	const result = await getEmDashEntry('archives', slug);
	entry = result.entry;
	isPreview = result.isPreview;

	if (result.error) {
		// A miss is `entry: null` with no error; any error is a real failure (#121), so rethrow
		// and let src/pages/500.astro render (503 when the content store itself is down, #128).
		if (!isExpectedLookupMiss(result.error)) {
			await rethrowLookupFailure(result.error, assertContentStoreReady);
		}
		entry = null;
	}

	if (!entry) {
		// A 404 only on a live database: an unmigrated / empty one is a 503 (#128).
		await assertContentStoreReady();
		notFound = true;
		// #151: an issue that was published and has since been unpublished or trashed is 410 Gone
		// (same noindex page). no-store so a republish is visible at once (`archive-withdrawn.ts`).
		withdrawn = await checkArchiveWithdrawn(slug, lookupArchiveRowState, console);
		if (withdrawn) {
			Astro.response.status = ARCHIVE_GONE_STATUS;
			Astro.response.headers.set('Cache-Control', ARCHIVE_GONE_CACHE_CONTROL);
		} else {
			Astro.response.status = 404;
		}
	}
}

// #151: a published entry whose PDF is gone from R2 says so instead of linking a 404.
let pdfStatus: ArchivePdfStatus = 'unknown';
if (entry) {
	const { pdfLink } = buildContentEntryViewModel(
		entry as unknown as { slug?: string; data: Record<string, unknown> } & Record<string, unknown>,
	);
	if (pdfLink) {
		const media = (cfEnv as { MEDIA?: { head?: (key: string) => Promise<unknown> } }).MEDIA;
		const head: MediaHead | null = typeof media?.head === 'function' ? (key) => media.head!(key) : null;
		pdfStatus = (await checkArchivePdf(pdfLink, head, console, { slug })).status;
		const cacheControl = archivePdfCacheControl(pdfStatus);
		if (cacheControl) Astro.response.headers.set('Cache-Control', cacheControl);
	}
}
---

{notFound && withdrawn ? (
	<NotFoundView eyebrow="410" heading="Archive issue withdrawn" summary="This archive issue has been withdrawn and is no longer available." />
) : notFound || !entry ? (
	<NotFoundView eyebrow="Archive" heading="Archive not found" summary="The requested archive issue may have been unpublished, moved, or removed." />
) : (
	<EmDashContentView
		entry={entry}
		collectionLabel="Archive"
		emdashCollection="archives"
		displayName={displayName}
		isPreview={isPreview}
		isAdmin={isAdmin}
		isSignedIn={isSignedIn}
		pdfStatus={pdfStatus}
	/>
)}

