---
import SecureAccessWall from '../components/SecureAccessWall.astro';
import { isLockedSiteAccess } from '../lib/auth';
import { getOptionalEditorialSession } from '../lib/editorial-session';
import { resolveRootGet } from '../lib/root-route';

const isLocked = isLockedSiteAccess();
const session = await getOptionalEditorialSession({
	cookies: Astro.cookies,
	url: Astro.url,
	request: Astro.request,
	redirect: Astro.redirect,
});
const rootAction = resolveRootGet({
	siteAccess: isLocked ? 'locked' : 'public',
	hasEditorialSession: Boolean(session),
});

if (rootAction.kind === 'redirect') {
	return Astro.redirect(rootAction.location, rootAction.status);
}

// Render the wall in this route. Do not Astro.rewrite('/login-wall'): rewrite
// re-runs EmDash middleware and, on the Cloudflare custom domain (not
// workers.dev), document requests hang at 0 bytes until timeout. Staging
// version 230af65d (PR 88 /homepage→/ work) showed that split; 7a0ef658
// answered because locked `/` rendered SecureAccessWall inline.
const denied = Astro.url.searchParams.get('denied') === '1';
const showLoginWall = rootAction.kind === 'login-wall';

let isAdmin = false;
let isSignedIn = false;
const HomepageView = showLoginWall
	? null
	: (await import('../components/HomepageView.astro')).default;

if (!showLoginWall && session) {
	isAdmin = session.isAdmin;
	isSignedIn = true;
}
---
{showLoginWall ? (
	<SecureAccessWall denied={denied} />
) : HomepageView ? (
	<HomepageView isAdmin={isAdmin} isSignedIn={isSignedIn} />
) : null}
