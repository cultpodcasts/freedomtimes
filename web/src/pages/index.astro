---
import { isLockedSiteAccess } from '../lib/auth';
import { getOptionalEditorialSession } from '../lib/editorial-session';
import { resolveRootGet } from '../lib/root-route';

const isLocked = isLockedSiteAccess();
const session = await getOptionalEditorialSession({
	cookies: Astro.cookies,
	url: Astro.url,
	request: Astro.request,
	redirect: Astro.redirect,
});
const rootAction = resolveRootGet({
	siteAccess: isLocked ? 'locked' : 'public',
	hasEditorialSession: Boolean(session),
});

if (rootAction.kind === 'redirect') {
	return Astro.redirect(rootAction.location, rootAction.status);
}

if (rootAction.kind === 'login-wall') {
	// Separate route so newspaper CSS / getEmDashCollection never enter this response.
	return Astro.rewrite('/login-wall' + Astro.url.search);
}

const HomepageView = (await import('../components/HomepageView.astro')).default;
let isAdmin = false;
let isSignedIn = false;
if (session) {
	isAdmin = session.isAdmin;
	isSignedIn = true;
}
---
<HomepageView isAdmin={isAdmin} isSignedIn={isSignedIn} />
