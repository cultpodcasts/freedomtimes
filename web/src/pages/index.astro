---
import HomepageView from '../components/HomepageView.astro';
import SecureAccessWall from '../components/SecureAccessWall.astro';
import { isLockedSiteAccess } from '../lib/auth';
import { getOptionalEditorialSession } from '../lib/editorial-session';

const denied = Astro.url.searchParams.get('denied') === '1';
const isLocked = isLockedSiteAccess();

let isAdmin = false;
let isSignedIn = false;

if (!isLocked) {
	const session = await getOptionalEditorialSession({
		cookies: Astro.cookies,
		url: Astro.url,
		request: Astro.request,
		redirect: Astro.redirect,
	});
	if (session) {
		isAdmin = session.isAdmin;
		isSignedIn = true;
	}
}
---
{isLocked ? (
	<SecureAccessWall denied={denied} />
) : (
	<HomepageView isAdmin={isAdmin} isSignedIn={isSignedIn} />
)}
